# === Saleor ===
SALEOR_DB_PASSWORD=change_me_saleor_db
DATABASE_URL=postgresql://saleor:${SALEOR_DB_PASSWORD}@db-saleor:5432/saleor
REDIS_URL=redis://:redis_password@redis:6379/0

# === FastAPI ===
FASTAPI_DB_PASSWORD=change_me_fastapi_db
FASTAPI_DATABASE_URL=postgresql://fastapi:${FASTAPI_DB_PASSWORD}@db-fastapi:5432/fastapi

# === Redis ===
REDIS_PASSWORD=change_me_redis

# === Saleor App ===
SECRET_KEY=change_me_secret_key_at_least_32_chars
ALLOWED_HOSTS=localhost,api.yourdomain.com
DEBUG=false

# === FastAPI Admin Auth ===
# 管理员登录凭据（生产环境 ADMIN_PASSWORD 必须 >= 16 字符强密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# JWT 签名密钥（生产环境必须修改默认值，>= 32 字符随机字符串）
ADMIN_JWT_SECRET=change_me_admin_jwt_secret_at_least_32_chars
# Token 有效期（分钟），默认 1440 = 24 小时
ADMIN_JWT_EXPIRE_MINUTES=1440

# === Brevo (Email) ===
BREVO_API_KEY=your_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3
ADMIN_EMAIL=admin@yourdomain.com

# === Saleor GraphQL ===
SALEOR_GRAPHQL_URL=http://saleor-api:8000/graphql/

# === Sentry ===
SENTRY_DSN=

# === WhatsApp ===
WHATSAPP_NUMBER=8613800138000

# === Domain ===
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com

# === Frontend (Next.js / Vercel) ===
# Saleor GraphQL API URL（前端访问，通过 Nginx 代理）
NEXT_PUBLIC_SALEOR_API_URL=https://api.yourdomain.com/graphql/
# FastAPI URL（前端访问，通过 Nginx 代理）
NEXT_PUBLIC_FASTAPI_URL=https://api.yourdomain.com/fastapi
# WhatsApp 号码（前端悬浮按钮）
NEXT_PUBLIC_WHATSAPP_NUMBER=8613800138000
# Saleor Channel
NEXT_PUBLIC_SALEOR_CHANNEL=default-channel

# === MeiliSearch (Phase 3) ===
MEILI_MASTER_KEY=change_me_meili
